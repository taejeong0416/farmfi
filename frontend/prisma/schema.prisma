generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 사용자 ───
model User {
  id           String   @id @default(cuid())
  name         String
  role         String   // investor, landlord, operator, admin
  email        String?  @unique
  passwordHash String?  // 이메일+비밀번호 로그인 (bcrypt 해시)
  walletAddress String? @unique // 투자(청약) 시 연결하는 지갑 주소
  nonce        String?  // 지갑 연결 서명 챌린지 nonce
  balance      BigInt   @default(0) // 원화 잔액 (모의)
  // ─── 신원 인증 / KYC (OpenDID 모바일 신분증 연동) ───
  identityVerified    Boolean   @default(false) // 실명 인증 완료 여부
  verifiedAt          DateTime? // 인증 완료 시각
  realName            String?   // 검증된 실명
  birthDate           DateTime? // 생년월일 (적격투자 연령 판단)
  investorAnnualLimit BigInt?   // 연간 투자한도 (원 단위, 자본시장법 룰엔진 산출)
  businessRegNo       String?   // 사업자등록번호 (건물주/운영자)
  createdAt    DateTime @default(now())
  transactions          Transaction[]
  // ─── 실명확인 식별자 (OACX 모바일 신분증) ───
  // CI 원문은 저장하지 않는다. 중복가입 판별에는 동일성만 있으면 되고,
  // 원문을 들고 있으면 유출 시 타 서비스 계정까지 연결되는 범용 식별자가 된다.
  ciHash              String?   @unique // sha256(CI + 서버 시크릿)
  identityProvider    String?   // opendid, oacx

  tokenHoldings         TokenHolding[]
  dividendClaims        DividendClaim[]
  spaces                Space[]
  operatorApplications  OperatorApplication[]
  identityVerifications IdentityVerification[]
  notificationPrefs NotificationPref[]
  operatedProjects      Project[]              @relation("ProjectOperator")
  investments           Investment[]
  subscriptions         Subscription[]
  bankAccount           BankAccount?
  custodyWallet         CustodyWallet?
  agreementConsents     AgreementConsent[]
  credentials           OperatorCredential[]
}

// ─── 운영자 지원 신청 ───
model OperatorApplication {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  region         String   // 희망 운영 지역
  cropExperience String   // 작물 재배 경험
  availableHours String   // 주간 투입 가능 시간
  status         String   @default("applied") // applied → docs → education → matched → operating
  // ─── 운영 신청 7단계 (O-03 자격 → O-04 방문 → O-05 교육 → O-06 확정 → O-07 계약 → O-08 보증서) ───
  spaceId            String?   // 신청한 공간
  documents          String[]  // 제출 서류 URL
  reviewNote         String?   // 심사자 보완 요청 사유
  visitAt            DateTime? // 현장 방문 예약 시각
  visitNote          String?
  visitDoneAt        DateTime?
  educationProgress  Int       @default(0) // 0~100
  educationDoneAt    DateTime?
  confirmedAt        DateTime? // 공간 최종 확정
  contractSignature  String?
  contractSignedAt   DateTime?
  certificateNo      String?
  certificateIssuedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())
  visits           OperatorVisit[]
  courseProgresses OperatorCourseProgress[]
  contract         OperatorContract?
  credentials      OperatorCredential[]
}


// ─── 현장 방문 예약 (O-04) ───
// 신청 행의 visitAt 한 칸으로는 예약을 바꾸거나 취소한 이력을 담을 수 없다.
// 예약은 그 자체로 상태를 가진다.
model OperatorVisit {
  id            String              @id @default(cuid())
  applicationId String
  application   OperatorApplication @relation(fields: [applicationId], references: [id])
  spaceId       String?
  scheduledAt   DateTime
  // 화면에서 고른 시간 칸. 시각은 scheduledAt이 들고 있고 이건 어느 칸을 골랐는지다.
  slot          String
  note          String?
  // RESERVED → COMPLETED · CANCELLED. 일정을 바꿔도 RESERVED로 남는다.
  status        String    @default("RESERVED")
  // 방문 결과. 관리자 심사가 이 값을 본다 (명세 O-04).
  completedAt   DateTime?
  resultNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([applicationId, status])
}

// ─── 필수 교육 과정 (O-05) ───
// 시나리오 데이터가 아니라 기준 데이터다. 코드에 적힌 걸 DB에 맞춘다.
model OperatorCourse {
  id      String @id @default(cuid())
  code    String @unique
  title   String
  summary String
  seq     Int
  // 전체 진도에서 이 과정이 차지하는 비중(%). 활성 과정의 합이 100이다.
  weight     Int
  // 재생 길이(초). 이어보기가 이 값 대비 어디까지 봤는지를 말한다.
  durationSec Int     @default(600)
  isActive    Boolean @default(true)
  progresses  OperatorCourseProgress[]

  @@index([isActive, seq])
}

// ─── 과정별 진도 ───
model OperatorCourseProgress {
  id            String              @id @default(cuid())
  applicationId String
  application   OperatorApplication @relation(fields: [applicationId], references: [id])
  courseId      String
  course        OperatorCourse      @relation(fields: [courseId], references: [id])
  progress      Int                 @default(0) // 0~100
  // 중단 지점(초). 이어보기가 여기서 다시 시작한다 (명세 O-05).
  lastPositionSec Int       @default(0)
  completedAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([applicationId, courseId])
  @@index([applicationId])
}

// ─── 운영 계약 (O-07) ───
// 서명 시점의 본문과 해시를 들고 있다. 계약 조건이 나중에 바뀌어도
// 무엇에 서명했는지가 남는다.
model OperatorContract {
  id            String              @id @default(cuid())
  applicationId String              @unique
  application   OperatorApplication @relation(fields: [applicationId], references: [id])
  spaceId       String?
  body          String
  contentHash   String
  // DRAFT → SIGNATURE_REQUESTED → SIGNED (· CANCELLED)
  status               String    @default("DRAFT")
  signatureRequestedAt DateTime?
  signature            String?
  signedAt             DateTime?
  termStart            DateTime?
  termEnd              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ─── 신원 인증 세션 (OpenDID Verifier 흐름 — 모바일 신분증) ───
model IdentityVerification {
  id        String   @id @default(cuid())
  userId    String?  // 로그인 전 세션도 허용 (익명 → 인증 후 연결)
  user      User?    @relation(fields: [userId], references: [id])
  txId      String   @unique // Verifier 트랜잭션 ID (request-offer-qr)
  status    String   @default("pending") // pending → submitted → verified → failed
  claims    Json?    // confirm-verify로 받은 검증 클레임
  createdAt DateTime @default(now())
}

// ─── 유휴공간 등록 ───
model Space {
  id               String   @id @default(cuid())
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  spaceType        String   // rooftop, vacant_store, indoor
  address          String
  area             String   // ~50평, 50~100평 등 구간 문자열
  electricity      String   // 전기 가능/부분 가능 등
  water            String   // 수도 가능/부분 가능 등
  lighting         String   // 채광 조건: 매우 좋음/좋음/보통/낮음
  preferredMode    String   // 임대형, 수익 공유형, 협의 가능
  photos           String[] // Supabase Storage URL 목록
  suitabilityScore Int?     // 스마트팜 적합도 (%)
  estimatedRent    Int?     // 예상 월 임대 수익 (원)
  status           String   @default("submitted") // submitted, reviewing, approved, rejected
  createdAt        DateTime @default(now())
}

// ─── 지점/사이트 (STO 라운드 단위이자 운영 단위) ───
model Project {
  id            String       @id @default(cuid())
  name          String
  description   String?
  location      String?
  buildingType  String?
  areaSqm       Float?
  // ─── STO 펀딩 (펀딩 전 운영 지점은 null) ───
  tokenSymbol     String?
  tokenPrice      BigInt?         // 원화 단가
  totalTokens     Int?
  soldTokens      Int             @default(0)
  targetAmount    BigInt?
  currentAmount   BigInt          @default(0)
  totalCapex      BigInt          @default(0)
  fundingStart    DateTime?
  fundingEnd      DateTime?
  contractAddress String?
  status        String       @default("operating") // upcoming, funding, funded, operating, paused, rejected, completed, failed
  failedAt      DateTime?    // 마일스톤 기한 초과로 실패 전환된 시각 (status="failed"와 함께 기록)
  // ─── 프로젝트 카드 표기 (C-01 · I-01). 값이 없으면 그 칸을 그리지 않는다. ───
  esgTag           String?   // 공실 재생 · 로컬 유통 · 에너지 절감
  targetReturnPct  Int?      // 목표 총 회수율 (%). 원금 비보장 배지와 같이 쓴다
  paybackMonths    Int?      // 예상 회수기간 (개월)
  imageUrl      String?
  institutionId String?      // 도입 기관 (성과 리포트 집계 단위)
  institution   Institution? @relation(fields: [institutionId], references: [id])
  operatorId    String?      // 이 지점을 운영하는 운영자 (운영자 몫 지급 대상)
  operator      User?        @relation("ProjectOperator", fields: [operatorId], references: [id])
  createdAt     DateTime     @default(now())
  escrow         Escrow?
  milestones     Milestone[]
  transactions   Transaction[]
  tokenHoldings  TokenHolding[]
  dividends      Dividend[]
  partners       ProjectPartner[]
  navSnapshots   NavSnapshot[]
  iotData        IotData[]
  inventories    Inventory[]
  harvestRecords HarvestRecord[]
  salesRecords   SalesRecord[]
  sensorThresholds SensorThreshold[]
  devices          Device[]
  stockAdjustments StockAdjustment[]
  settlementRule SettlementRule?
  payouts        Payout[]
  investments    Investment[]
  subscriptions  Subscription[]
  periodRecords      PeriodRecord[]
  setpointApplications SetpointApplication[]
  credentials          OperatorCredential[]
}

// ─── 에스크로 ───
model Escrow {
  id              String  @id @default(cuid())
  projectId       String  @unique
  project         Project @relation(fields: [projectId], references: [id])
  totalLocked     BigInt  @default(0)
  totalReleased   BigInt  @default(0)
  remaining       BigInt  @default(0)
  status          String  @default("active") // active → failed(기한 초과) → refunded(환불 완료)
  contractAddress String?
}

// ─── 마일스톤 ───
model Milestone {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id])
  seq                  Int
  name                 String
  description          String?
  releasePct           Int            // 3500 = 35%
  releaseAmount        BigInt         @default(0)
  status               String         @default("pending") // pending, in_progress, verified, completed, failed, manual_review
  conditionText        String?
  requiredSignals      String[]       // ["contract", "receipt", "photo", "iot"]
  iotMinDays           Int            @default(0)
  retryCount           Int            @default(0)
  crossCheck           String?
  assetValue           BigInt         @default(0)
  evidenceUrl          String?
  // ─── 증빙 제출·승인 게이트 (O-11 제출 → A-08 재검토) ───
  // status: pending → evidence_submitted → in_progress(검증) → verified(승인)
  //         → completed(집행). 보완이 필요하면 revision_required로 되돌린다.
  evidenceUrls         String[]  // 운영자가 올린 증빙 파일들
  // 파일별 sha256(업로드 시점 계산). 원본은 저장소에, 체인에는 이 해시만 올린다.
  // evidenceUrls와 같은 순서다. 원본이 바뀌면 해시가 어긋나 위·변조가 드러난다.
  evidenceHashes       String[]  @default([])
  evidenceNote         String?   // 제출 시 남긴 설명
  evidenceSubmittedAt  DateTime?
  reviewNote           String?   // 관리자 재검토 의견
  reviewedById         String?
  reviewedAt           DateTime?
  aiVerificationResult Json?
  completedAt          DateTime?
  // 이 마일스톤의 집행 기한. Escrow.sol의 milestoneDeadline(= 직전 트랜치 집행 +
  // MILESTONE_TIMEOUT 180일)을 DB에 미러링한 값이다. 기한이 지나면 타임아웃 실패
  // 전환(POST /api/milestones/[id]/timeout) 대상이 된다. 아직 시계가 시작되지 않은
  // 단계는 null.
  deadlineAt           DateTime?
  notifications        Notification[]
  appeals              Appeal[]
  reviewItems          MilestoneReviewItem[]

  @@unique([projectId, seq])
}

// ─── 거래 내역 ───
model Transaction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String?  // null = 시스템 거래 (트랜치 해제 등)
  user        User?    @relation(fields: [userId], references: [id])
  type        String   // subscription, tranche_release, dividend, revenue, refund
  amount      BigInt
  tokenAmount Int?
  txHash      String?
  blockNumber Int?
  memo        String?
  createdAt   DateTime @default(now())
}

// ─── 토큰 보유 ───
model TokenHolding {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  amount    Int
  avgPrice  BigInt

  @@unique([userId, projectId])
}

// ─── 배당 ───
model Dividend {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  totalRevenue  BigInt
  totalDividend BigInt
  perToken      BigInt
  period        String
  createdAt     DateTime        @default(now())
  claims        DividendClaim[]
}

// ─── 배당 수령 ───
model DividendClaim {
  id          String   @id @default(cuid())
  dividendId  String
  dividend    Dividend @relation(fields: [dividendId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenAmount Int
  claimAmount BigInt
  claimed     Boolean  @default(false)
  claimedAt   DateTime?
}

// ─── IoT 데이터 ───
model IotData {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  temperature    Float
  humidity       Float
  co2Level       Float
  lightIntensity Float
  phLevel        Float
  // 양액 전기전도도 (dS/m). 양분 농도의 대리 지표로 pH와 한 쌍이다.
  // nullable인 이유: EC를 재지 않는 원천(공개데이터 온실 계열)이 섞인다.
  // 0을 기본값으로 두면 "안 쟀다"와 "0으로 쟀다"가 같은 값이 되어, 학습이
  // 물리적으로 불가능한 EC 0을 실측으로 먹는다.
  ecLevel        Float?
  growthRate     Float    @default(0)
  anomalyScore   Float    @default(0)
  isAnomaly      Boolean  @default(false)
  recordedAt     DateTime @default(now())

  @@index([projectId, recordedAt])
}

// ─── 알림 (마일스톤 검증 이벤트 + 생육 이상) ───
model Notification {
  id          String     @id @default(cuid())
  projectId   String?    // 생육 이상 발생 지점
  milestoneId String?    // STO 마일스톤 검증 이벤트
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  type        String     // verification_failed, anomaly_detected, manual_review
  message     String
  evidenceUrl String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// ─── 프로젝트 파트너 ───
model ProjectPartner {
  id                     String  @id @default(cuid())
  projectId              String
  project                Project @relation(fields: [projectId], references: [id])
  role                   String  // landlord, equipment_partner
  name                   String
  userId                 String? // 계정이 있는 파트너 — 지급 내역을 본인이 조회할 수 있게 연결
  totalContribution      BigInt  @default(0)
  recoveredAmount        BigInt  @default(0)
  monthlyRecoveryAmount  BigInt  @default(0)
  recoveryComplete       Boolean @default(false)
}

// ─── NAV 스냅샷 ───
model NavSnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  nav                Float
  escrowBalance      BigInt
  assetValue         BigInt
  cumulativeCashFlow BigInt
  recordedAt         DateTime @default(now())
}

// ─── AI 검증 결과 캐시 (시연 안정성용) ───
model AiCache {
  id          String   @id @default(cuid())
  milestoneId String
  signalType  String   // contract, receipt, photo
  result      Json?
  createdAt   DateTime @default(now())

  @@unique([milestoneId, signalType])
}

// ─── 데모 캐시 ───
model DemoCache {
  id          String   @id @default(cuid())
  step        Int
  signalType  String?
  txHash      String?
  blockNumber Int?
  result      Json?
  createdAt   DateTime @default(now())
}

// ─── 도입 기관 (공공·대학·ESG 기업) — 성과 리포트 소유자 ───
model Institution {
  id           String    @id @default(cuid())
  name         String
  type         String    // public, university, esg_company
  contactName  String?
  contactEmail String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

// ─── 감사 로그 (청약·검증·집행·정산·권한변경 추적) ───
// 다른 모델과 FK로 묶지 않는다. 감사 기록은 대상 행이 삭제·변경돼도 그 자체로 남아야
// 하므로 actorId·entityId·projectId를 값으로만 들고 있는다.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null = 시스템 이벤트 (스케줄러·자동 집행)
  actorRole  String?  // investor, operator, landlord, admin, system
  action     String   // subscription.created, milestone.verified, payout.processed 등
  entityType String   // project, milestone, dividend, payout, appeal, settlement_rule, user
  entityId   String?
  projectId  String?  // 프로젝트 단위 필터용 (entityType이 project가 아닐 때도 채움)
  summary    String   // 화면에 그대로 뿌리는 한 줄 요약
  detail     Json?    // 변경 전/후 값 등 부가 정보
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// ─── 정산 규칙 (프로젝트별 — 행이 없으면 lib/waterfall.ts 기본값) ───
// 임대료는 여기 두지 않는다. ProjectPartner(role="landlord").monthlyRecoveryAmount가
// 이미 프로젝트별 월 고정 임대료를 들고 있어 단일 출처로 유지한다.
model SettlementRule {
  id                 String  @id @default(cuid())
  projectId          String  @unique
  project            Project @relation(fields: [projectId], references: [id])

  // ─── 월 비용 (기획 0826 슬라이드 35·38) ───
  // 매출에서 아래를 빼면 "투자자 배분 전 이익"이 된다.
  /** 팩당 변동비(원). 판매량에 비례한다 — 고정비가 아니다. */
  unitVariableCost   BigInt  @default(1500)
  /** 결제 수수료율. 매출에 비례. */
  paymentFeeRate     Float   @default(0.015)
  /** 운영자 보수(월). 매출과 무관하게 먼저 나간다. */
  operatorPay        BigInt  @default(700000)
  /** 전기·관리·수도(월). */
  facilityCost       BigInt  @default(1230000)
  /** 소모품·유지보수(월). 유닛 수에 비례하지만 기간 내 고정으로 본다. */
  unitUpkeepCost     BigInt  @default(476000)
  /** 팜피 서비스 이용료(월). 팜피 수익이지 배당 재원이 아니다. */
  platformFee        BigInt  @default(50000)

  // ─── 투자자 회수 (기획 0826 슬라이드 36·37) ───
  // 배분액은 남은 이익을 나누는 게 아니라 투자안이 먼저 정한다.
  // 매장은 그 회수액을 감당할 수 있는지 검증받는다(필요 판매량 ≤ 기준 판매량).
  /** 연 프리미엄. 0.06 = 연 6%. */
  annualPremiumRate  Float   @default(0.06)
  /** 회수 기간(개월). 실적이 안 나오면 최대 36개월까지 연장. */
  recoveryMonths     Int     @default(24)

  monthlyPlatformFee BigInt  @default(200000) // [폐기] v18 수수료 풀 잔재
  experienceFeeRate  Float   @default(0.3)    // [폐기]
  b2bFeeRate         Float   @default(0.08)   // [폐기]
  deficitInvestorShare Float  @default(0.6)   // [폐기]
  surplusInvestorShare Float  @default(0.6)   // [폐기]
  breakEvenRevenue     BigInt @default(0)     // [폐기]

  updatedById        String?
  updatedAt          DateTime @updatedAt
}

// ─── 이의제기 (반려·보류 마일스톤에 대한 단계적 재검증) ───
model Appeal {
  id            String    @id @default(cuid())
  milestoneId   String
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  projectId     String    // 프로젝트 단위 조회용 비정규화 (milestone 조인 회피)
  submittedById String    // 이의제기한 운영자
  reason        String
  // open(접수) → under_review(운영팀 검토) → escalated(외부 전문가) → approved/rejected(최종)
  status        String    @default("open")
  decision      String?   // 최종 판정 사유
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  comments      AppealComment[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ─── 이의제기 코멘트 스레드 ───
model AppealComment {
  id            String   @id @default(cuid())
  appealId      String
  appeal        Appeal   @relation(fields: [appealId], references: [id])
  authorId      String
  authorRole    String   // operator, admin (운영팀), auditor (외부 전문가)
  body          String
  attachmentUrl String?  // 보완 자료
  createdAt     DateTime @default(now())

  @@index([appealId, createdAt])
}

// ─── 지급 원장 (배당·임대료·운영자 정산) ───
// MVP 범위: 실제 계좌이체·온체인 전송은 하지 않는다. 지급 예정 건을 등록하고
// 상태(예정/완료/실패)와 증빙만 관리한다 (명세 2.2.1).
model Payout {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  category      String    // dividend, landlord_rent, operator_settlement
  payeeUserId   String?   // 계정이 없는 수취인(건물주 파트너 등)은 null
  payeeName     String
  amount        BigInt
  period        String    // YYYY-MM
  status        String    @default("scheduled") // scheduled → processing → paid / failed
  paidAt        DateTime?
  // 실패 사유 코드. 사람이 읽는 문장(failureReason)만으로는 무엇을 해야 하는지가
  // 갈리지 않는다 — 은행 오류는 그대로 다시 걸면 되고 계좌 문제는 수취인이 고쳐야
  // 재시도가 의미 있다. 코드별 다음 행동은 lib/payout-failure.ts가 정한다.
  failureCode   String?
  failureReason String?
  retryCount    Int       @default(0) // 이체를 실제로 보낸 횟수
  lastAttemptAt DateTime?
  evidenceUrl   String?   // 세금계산서 등 지급 증빙
  memo          String?
  createdAt     DateTime  @default(now())

  // 같은 기간·같은 수취인에게 같은 항목이 두 번 등록되는 것을 막는다.
  @@unique([projectId, period, category, payeeName])
  @@index([payeeUserId, period])
  @@index([status, period])
}

// ─── 품목 마스터 (재배·판매 대상 작물) ───
model Product {
  id        String   @id @default(cuid())
  name      String   // 상추, 루꼴라, 바질
  category  String   // leafy, herb
  unit      String   @default("봉")
  unitPrice Int      // 판매단가 (원)
  growDays  Int      // 파종~수확 재배일수
  createdAt DateTime @default(now())
  inventories    Inventory[]
  harvestRecords HarvestRecord[]
  salesRecords   SalesRecord[]
  stockAdjustments StockAdjustment[]
}

// ─── 재고-생육 (지점×품목 현재 상태) — '오늘 할 일' 집계 원천 ───
model Inventory {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  inStock           Int       @default(0) // 매장 진열 재고 (봉)
  growing           Int       @default(0) // 재배중 수량 (봉)
  plantedAt         DateTime? // 파종일
  expectedHarvestAt DateTime? // 예상 수확일
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, productId])
}

// ─── 수확 실적 (생산량 집계 — 검증 필드 없음) ───
model HarvestRecord {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      // 수확량 (봉)
  harvestedAt DateTime @default(now())

  @@index([projectId, harvestedAt])
}

// ─── 판매 실적 (운영자 수기입력 — 판매-재배 연동 원천) ───
model SalesRecord {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      // 판매 수량 (봉). 취소·환불은 음수.
  amount    Int      // 매출 (원). 취소·환불은 음수.
  soldAt    DateTime @default(now())
  // POS가 준 거래번호. 같은 거래를 두 번 밀어넣어도 한 번만 기록된다.
  // 수동 입력분은 null — POS 없이도 매출을 적을 수 있어야 한다.
  posTxId   String?  @unique
  // manual(운영자 입력) · pos(POS 수집). 어디서 온 숫자인지 구분한다.
  channel   String   @default("manual")

  @@index([projectId, soldAt])
}

// ─────────────────────────────────────────────────────────────
// 운영앱 기능명세(2026-08-13) 추가 모델
// ─────────────────────────────────────────────────────────────

// 명세 4.2 센서 임계값 설정 — 지점별로 정상범위를 덮어쓴다.
// 행이 없으면 lib/iot-health 의 HEALTHY_RANGES 기본값을 쓴다.
// 즉 "설정 안 함"과 "기본값과 같게 설정함"이 구분된다.
model SensorThreshold {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  sensor    String   // temperature, humidity, co2Level, lightIntensity, phLevel
  minValue  Float
  maxValue  Float
  updatedBy String?  // User.id — 누가 바꿨는지가 사고 조사에 필요하다
  updatedAt DateTime @updatedAt

  @@unique([projectId, sensor])
}

// 명세 4.2 설비 제어 — 베드에 물린 설비와 현재 상태.
model Device {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  bed          String          // A, B, C, D
  kind         String          // led, fan, pump
  name         String          // LED 조명, 환기팬, 관수 펌프
  isOn         Boolean         @default(false)
  controllable Boolean         @default(true) // false = 자동제어 전용
  updatedAt    DateTime        @updatedAt
  commands     DeviceCommand[]

  @@index([projectId, bed])
}

// 제어 이력 — 명세가 요구하는 "요청·결과 시각, 요청자, 결과 상태".
// 명령과 결과를 한 행에 두는 이유: 응답 없음(pending 으로 남음)과 실패를
// 구분해야 하고, 그 구분이 곧 "설비가 실제로 그 상태인가"의 근거다.
model DeviceCommand {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id])
  requestedBy String?   // User.id
  targetState Boolean   // 요청한 on/off
  status      String    @default("pending") // pending, success, failed
  failReason  String?
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([deviceId, requestedAt])
}

// 명세 7.1 알림 수신 설정 — 사용자별 유형별 on/off + 채널.
model NotificationPref {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // device_critical, device_warning, stock_low, harvest, report
  enabled   Boolean  @default(true)
  channel   String   @default("push") // push, sms, both
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

// 명세 5.1 재고 수동 조정 이력.
// HarvestRecord(수확 입고)·SalesRecord(판매 출고)로 설명되지 않는 변동
// — 폐기, 실사 보정 등 — 만 여기 남는다. 사유가 필수인 이유다.
model StockAdjustment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  delta       Int      // 증감 (봉). 0 은 허용하지 않는다
  beforeQty   Int
  afterQty    Int
  reason      String
  adjustedBy  String?  // User.id
  adjustedAt  DateTime @default(now())

  @@index([projectId, adjustedAt])
}
// ─── 투자 신청 (다단계 청약 흐름) ───
// 화면 I-02~I-04가 이 레코드 하나의 상태를 밀고 나간다. 실제 납입은 마지막
// 단계에서 executeSubscription을 호출해 처리하고, 결과를 여기에 기록한다.
model Investment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  // DRAFT → IDENTITY_REQUIRED → ELIGIBILITY_CHECKED → CONSENT_REQUIRED →
  // AWAITING_DEPOSIT → DEPOSIT_CONFIRMED → COMPLETED (+ DEPOSIT_FAILED · CANCELLED)
  status     String   @default("DRAFT")
  amount     BigInt   @default(0) // 신청 금액 (원)
  units      Int      @default(0) // 보유 구좌 수
  // 적합성 판정 결과 (연간한도·본인확인·연령)
  eligible       Boolean?
  eligibilityMemo String?
  annualLimit    BigInt?
  // 동의·서명
  consentedAt  DateTime?
  signature    String?
  // 이 신청에서 동의한 문서들을 하나로 묶은 해시. 체인에 계약 해시를 기록할 때
  // 올릴 값이다 (명세 10.4). 문서 원문이 아니라 이 값만 체인으로 나간다.
  agreementHash String?
  // 납입 결과
  transactionId String?
  failureReason String?
  // 납입 예외 구분 (I-03E 네 분기)
  // VIRTUAL_ACCOUNT_FAILED · DEPOSIT_EXPIRED · AMOUNT_MISMATCH · DEPOSIT_INQUIRY
  failureCode   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  virtualAccounts VirtualAccount[]
  depositEvents   DepositEvent[]
  issuances       HoldingIssuance[]
  consents        AgreementConsent[]

  @@index([userId, createdAt])
  @@index([projectId, status])
}

// ─── 동의 문서 (명세 5.2 · 10.6) ───
// 문서는 고쳐 쓰지 않고 버전을 올린다. 이미 동의한 사람이 본 문서가 나중에 바뀌면
// "무엇에 동의했는지"를 증명할 수 없다. 본문이 바뀌면 새 행이다.
model Agreement {
  id      String @id @default(cuid())
  // investment_contract · risk_disclosure · privacy_consent
  code    String
  version String
  title   String
  body    String
  // sha256(body). 동의 기록에 같이 박아 문서 원문과의 연결을 남긴다.
  contentHash String
  // 필수 문서는 전부 동의해야 투자 신청이 넘어간다.
  required    Boolean  @default(true)
  // 화면에 늘어놓는 순서
  sortOrder     Int      @default(0)
  effectiveFrom DateTime @default(now())
  // 새 버전이 나오면 옛 버전은 false. 지우지 않는다 — 과거 동의가 가리키는 문서다.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  consents      AgreementConsent[]

  @@unique([code, version])
  @@index([isActive, sortOrder])
}

// ─── 동의 기록 ───
// 누가 · 어느 문서(버전)에 · 언제 · 무엇으로 서명했는지. 문서 해시를 여기에도
// 복사해 둔다 — Agreement 행을 잘못 건드려도 동의 시점의 값이 남는다.
model AgreementConsent {
  id String @id @default(cuid())
  // `<userId>:<agreementId>:<investmentId|->`. Postgres는 NULL을 서로 다르게 보므로
  // investmentId가 없는 동의까지 막으려면 복합 unique가 아니라 이 키가 필요하다.
  consentKey  String @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id])
  // 어느 투자 신청에 대한 동의인지. 신청과 무관한 동의는 null.
  investmentId String?
  investment   Investment? @relation(fields: [investmentId], references: [id])
  contentHash  String
  signature    String
  // 명세 5.2 — 동의는 본인확인 세션을 재확인한 뒤에 이뤄진다.
  identityVerificationId String?
  consentedAt            DateTime @default(now())

  @@index([userId, consentedAt])
  @@index([investmentId])
}

// ─── 회수·환불 계좌 (C-I03) ───
// 계좌번호 원문은 두지 않는다. 지급사 토큰 자리(accountToken)와 마스킹값만 남긴다.
model BankAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  bankName     String
  maskedNumber String   // 표시용 (앞 3자리 · 뒤 4자리)
  accountToken String   // 지급사 토큰 자리 — 지금은 계좌 식별 해시
  holderName   String   // 확인된 예금주
  verifiedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())
}

// ─── 건별 가상계좌 (I-03) ───
// 동의를 마친 신청 한 건에 대해 발급한다. 기한이 지나면 EXPIRED로 두고 새로 발급한다.
model VirtualAccount {
  id                String     @id @default(cuid())
  investmentId      String
  investment        Investment @relation(fields: [investmentId], references: [id])
  provider          String     // 지급사 식별자
  providerAccountId String     @unique // 지급사가 준 가상계좌 식별자
  bankName          String
  accountNumber     String
  holderName        String     // 입금 받는 쪽 예금주 (신탁 계정)
  amount            BigInt     // 입금해야 할 금액
  expiresAt         DateTime
  status            String     @default("ISSUED") // ISSUED · PAID · EXPIRED · CANCELLED
  // 지급사가 웹훅 검증용으로 준 값. 토스페이먼츠는 HMAC 서명이 아니라 발급 때 받은
  // secret을 웹훅 본문의 secret과 대조하는 방식이라 계좌마다 따로 들고 있어야 한다.
  providerSecret    String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt @default(now())

  @@index([investmentId, createdAt])
}

// ─── 은행 입금 이벤트 ───
// 같은 거래번호는 한 번만 처리한다(providerTransactionId unique).
// CONFIRMED가 아닌 건은 관리자 검토 큐에서 사람이 판단한다.
model DepositEvent {
  id                    String     @id @default(cuid())
  investmentId          String
  investment            Investment @relation(fields: [investmentId], references: [id])
  providerTransactionId String     @unique
  amount                BigInt     // 실제 입금액
  expectedAmount        BigInt     // 신청 금액
  payerName             String?
  status                String     // CONFIRMED · AMOUNT_MISMATCH · LATE
  reviewedAt            DateTime?
  reviewNote            String?
  receivedAt            DateTime   @default(now())

  @@index([status, receivedAt])
}

// ─── 정기구독 (구매자) ───
// 배송이 아니라 지정한 지점에서 직접 받는 픽업 구독이다.
// 팩 크기(3·5·7종)와 수령 주기를 고르고, 지점 재고 안에서 작물·드레싱을 고른다.
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  projectId     String   // 픽업 지점
  project       Project  @relation(fields: [projectId], references: [id])
  packSize      Int      // 3 · 5 · 7 (작물 종수)
  perWeek       Int      @default(1) // 주 수령 횟수
  productIds    String[] // 고른 작물
  dressings     String[] // 고른 드레싱
  monthlyPrice  Int      // 월 결제액 (원)
  couponCode    String?
  discount      Int      @default(0)
  paymentMethod String?  // 표시용 결제수단 라벨
  status        String   @default("active") // active · paused · cancelled · waitlist
  startedAt     DateTime @default(now())
  nextPaymentAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
  pickups       PickupOrder[]

  @@index([userId, status])
}

// 구독 한 건의 회차. 매장에서 보여줄 확인번호를 갖는다.
model PickupOrder {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  scheduledAt    DateTime
  // scheduled(예정) · ready(준비 완료) · picked(수령 완료) · skipped(건너뜀) · missed(미수령)
  // 앱 명세의 SCHEDULED→PREPARING→READY→COMPLETED를 이 값들에 맞춘다.
  // PREPARING은 운영자가 체크하는 순간이 곧 ready라 따로 두지 않는다.
  status         String       @default("scheduled")
  // 매장 확인번호. 사람이 읽고 부르는 값이다.
  code           String       @unique
  // 바코드에 담기는 값. 확인번호는 구독 id와 날짜로 정해져 짐작할 수 있으므로
  // 스캔 대상은 따로 둔다. 앱이 이 값으로 회차를 찾아 수령 처리한다.
  barcodeToken    String?     @unique
  barcodeIssuedAt DateTime?
  preparedAt     DateTime?    // 운영자가 팩 준비를 마친 시각
  pickedAt       DateTime?
  pickedById     String?      // 수령 처리한 운영자 User.id — 중복 스캔 안내에 쓴다
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, scheduledAt])
  @@index([status, scheduledAt])
}

// ─── 수탁 지갑 (v2.1) ───
// 투자자에게 주소·개인키·가스비를 보이지 않는다. 서버가 투자자 1인당 지갑 하나를
// 만들어 들고 있고, 보유 구좌는 그 지갑 앞으로 발행된다.
// Open DID의 Wallet SDK(신원·VC 보관)와는 완전히 다른 층이다. 섞지 않는다.
model CustodyWallet {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id])
  chainAddress String            @unique
  // 개인키 원문은 저장하지 않는다. 개발은 AES-256-GCM 암호화 키스토어(`local:` 접두),
  // 운영은 KMS/HSM 참조값(`kms:` 접두)이 들어온다. 어느 쪽이든 이 값만으로는 키를
  // 복원할 수 없다 — 마스터 키가 따로 있어야 한다.
  keyRef       String
  status       String            @default("ACTIVE") // ACTIVE · SUSPENDED
  // 체인 신원 레지스트리 등록 시각. 등록돼야 2차 이전이 가능하다(발행은 게이트 밖).
  registeredAt DateTime?
  createdAt    DateTime          @default(now())
  issuances    HoldingIssuance[]
}

// ─── 보유 구좌 발행 이력 (v2.1) ───
// 입금 확인과 같은 트랜잭션에서 PENDING 행이 생기고(트랜잭셔널 아웃박스),
// Chain Relay가 그 행을 집어 체인에 올린다. DB 커밋과 체인 전송을 한 트랜잭션에
// 묶을 수 없으므로, 커밋된 의도를 남기고 전송은 재시도로 따라붙게 한다.
model HoldingIssuance {
  id            String        @id @default(cuid())
  // 멱등 키. 은행 웹훅이 두 번 와도 같은 eventId면 발행은 한 번뿐이다.
  eventId       String        @unique
  investmentId  String
  investment    Investment    @relation(fields: [investmentId], references: [id])
  walletId      String
  wallet        CustodyWallet @relation(fields: [walletId], references: [id])
  units         Int
  method        String        @default("mint") // mint · transfer · burn
  status        String        @default("PENDING") // PENDING · SENT · CONFIRMED · CHAIN_FAILED · CANCELLED
  chainTxHash   String?
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  occurredAt    DateTime      @default(now())
  settledAt     DateTime?

  @@index([status, nextAttemptAt])
  @@index([investmentId])
}

// ─── 대사 감사 큐 (v2.1) ───
// DB와 체인이 어긋난 사실을 적어 두는 곳. 대사는 절대 자동으로 고치지 않는다 —
// 어느 쪽이 맞는지는 기계가 판단할 수 없고, 잘못 맞추면 구좌가 이중으로 생기거나
// 사라진다. 여기 쌓인 행을 사람이 보고 처리한다.
model ReconciliationEntry {
  id           String   @id @default(cuid())
  // 같은 불일치가 매 회차 새 행으로 쌓이지 않게 하는 키.
  // 예: `holding:<walletId>:<날짜>` · `receipt:<issuanceId>`
  scopeKey     String   @unique
  // HOLDING_MISMATCH(지갑 잔액 불일치) · RECEIPT_REVERTED(체인에서 되돌려짐)
  // · RECEIPT_MISSING(해시는 있는데 영수증이 안 잡힘)
  kind         String
  entityType   String // custody_wallet · holding_issuance
  entityId     String
  // 대사 시점의 양쪽 값. 사람이 판단할 근거라 문자열로 그대로 남긴다.
  expectedText String
  actualText   String
  detail       Json?
  status       String   @default("OPEN") // OPEN · RESOLVED
  resolution   String?
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
}

// ─── 기간 정산 입력 (A-16 · Phase S1) ───
// 인수 기준: "관리자가 매출·비용을 확정해야 정산 계산이 돈다. 확정 전 값은
// 계산에 들어가지 않는다." 그래서 배당 라우트는 이 표에서 confirmed인 행만 읽는다.
// 화면이 들고 있던 비용 입력이 여기 저장된다 — 전에는 새로고침하면 사라졌다.
model PeriodRecord {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  period        String    // YYYY-MM
  // 매출은 SalesRecord 합계를 담당자가 확인해 확정한다. 자동 합계를 그대로
  // 쓰지 않는 이유: 반품·현장 판매 보정이 들어간다.
  revenue       BigInt    @default(0)
  // [{ label, amount }] — 항목 수가 지점마다 달라 Json으로 둔다
  costs         Json      @default("[]")
  totalCost     BigInt    @default(0)
  status        String    @default("draft") // draft · confirmed
  confirmNote   String?   // 확정 사유. 확정 시 필수 — 숫자만 남으면 왜 그 값인지 사라진다
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  @@unique([projectId, period])
  @@index([status, period])
}

// ─── 설정점 적용 기록 (Phase W2) ───
// 레시피 산출값과 실제 적용값을 **둘 다** 남긴다. 하나만 남기면 "모델이 뭐라 했고
// 우리가 뭘 했나"를 대조할 수 없고, 그러면 모델을 고칠 근거도 사라진다.
// 정산·마일스톤 판정에는 적용값을 쓴다 — 설비가 실제로 돈 값이 그쪽이다.
model SetpointApplication {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  cropKey   String
  // [{ feature, label, unit, proposed, applied, baseline, verdict, reason, bounds }]
  decisions Json
  /** 규칙이 산출을 손댄 요인 수. 0이면 학습 산출이 그대로 나갔다는 뜻 */
  adjusted  Int      @default(0)
  /** 반응면 판정 — 최대점이 아니면 산출을 채택하지 않는다 */
  surface   String
  samples   Int      @default(0)
  note      String?
  appliedById String?
  appliedAt DateTime @default(now())

  @@index([projectId, appliedAt])
}

// ─── 조건 항목별 판정 (A-08 · Phase T2) ───
// 명세: "단계의 조건 문구를 항목으로 쪼개 각 항목마다 충족·미충족과 근거가 된
// 증빙을 지정해야 승인 버튼이 열린다. 한 항목이라도 미지정이면 승인할 수 없다."
//
// 항목은 `Milestone.requiredSignals`를 그대로 쓴다 — 자동 검증도 신호 단위로
// 판정하므로 초안을 그 자리에 채울 수 있다. 증빙 해시는 원본의 동일성을
// 보장하고, 조건 충족 여부는 이 표가 담당한다. 둘은 다른 질문이다.
model MilestoneReviewItem {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  /** contract · receipt · photo · iot · crossCheck */
  signal      String
  /** undecided · met · unmet — undecided가 하나라도 있으면 승인이 열리지 않는다 */
  verdict     String    @default("undecided")
  /** 이 항목의 근거로 지정한 증빙 파일 */
  evidenceUrl String?
  note        String?
  /** 자동 검증이 채운 초안인가. 사람이 손대면 false가 된다 */
  autoDraft   Boolean   @default(true)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt @default(now())

  @@unique([milestoneId, signal])
  @@index([milestoneId])
}

// ─── 운영자 보증서 (O-08 · A-03 · Phase Q3) ───
// 앱이 이 보증서를 검증해 운영 기능을 열고 닫는다. 그래서 상태값이 정본이다.
//
// 테이블은 이미 DB에 있었다(스키마에는 없이). `applicationId`로 어느 신청에서
// 나온 보증서인지 추적하는 구조라 O-08 흐름(신청→심사→계약→발급)에 맞다.
// 기존 컬럼을 그대로 쓰고 두 개만 더한다 — `projectId`(앱이 연결할 매장)와
// `vcId`(Open DID VC 참조).
//
// 명세 17.1-8: "지점 운영계약 기간과 연동하고 교육·안전점검 만료 또는 중대 위반
// 시 정지한다." 정지는 되돌릴 수 있고 만료는 시간이 지나면 자동이다 — 둘을 한
// 상태로 합치면 "왜 막혔나"에 답할 수 없다.
model OperatorCredential {
  id            String  @id @default(cuid())
  /** 보증서 번호 — 앱에서 번호로 인증할 때 쓴다. 전역 유일 */
  credentialNo  String  @unique
  userId        String
  user          User    @relation(fields: [userId], references: [id])
  applicationId String
  application   OperatorApplication @relation(fields: [applicationId], references: [id])
  spaceId       String?
  /** 앱이 연결할 매장. 공간(Space)과 달리 운영 데이터가 붙는 단위다 */
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  /** active · suspended · expired · revoked */
  status        String   @default("active")
  issuedAt      DateTime @default(now())
  /** 지점 운영계약 종료일. 지나면 만료로 본다 */
  expiresAt     DateTime
  /** 정지·해지 사유 코드 */
  statusReason  String?
  /** 사람이 읽는 사유. 상태만 남기면 왜 막혔는지 아무도 모른다 */
  statusNote    String?
  statusChangedAt DateTime?
  statusChangedBy String?
  /**
   * Open DID VC 참조. 실제 발급이 붙기 전에는 null이고, 그때는 번호로만
   * 검증한다 — 없는 VC를 있는 척하지 않는다.
   */
  vcId          String?
  /**
   * Open DID 발급 오퍼. 보증서를 발급할 때 Issuer에서 받아 둔다 — 운영자가
   * DID 지갑으로 이 오퍼를 스캔하면 VC가 발급된다. 오퍼가 있다고 VC가 있는 건
   * 아니다: 아무도 수령하지 않으면 vcId는 계속 null이다.
   */
  vcOfferId     String?
  vcPlanId      String?
  vcOfferAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([status, expiresAt])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 사용자 ───
model User {
  id           String   @id @default(cuid())
  name         String
  role         String   // investor, landlord, operator, admin
  email        String?  @unique
  passwordHash String?  // 이메일+비밀번호 로그인 (bcrypt 해시)
  walletAddress String? @unique // 투자(청약) 시 연결하는 지갑 주소
  nonce        String?  // 지갑 연결 서명 챌린지 nonce
  balance      BigInt   @default(0) // 원화 잔액 (모의)
  // ─── 신원 인증 / KYC (OpenDID 모바일 신분증 연동) ───
  identityVerified    Boolean   @default(false) // 실명 인증 완료 여부
  verifiedAt          DateTime? // 인증 완료 시각
  realName            String?   // 검증된 실명
  birthDate           DateTime? // 생년월일 (적격투자 연령 판단)
  investorAnnualLimit BigInt?   // 연간 투자한도 (원 단위, 자본시장법 룰엔진 산출)
  businessRegNo       String?   // 사업자등록번호 (건물주/운영자)
  createdAt    DateTime @default(now())
  transactions          Transaction[]
  tokenHoldings         TokenHolding[]
  dividendClaims        DividendClaim[]
  spaces                Space[]
  operatorApplications  OperatorApplication[]
  identityVerifications IdentityVerification[]
  operatedProjects      Project[]              @relation("ProjectOperator")
}

// ─── 운영자 지원 신청 ───
model OperatorApplication {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  region         String   // 희망 운영 지역
  cropExperience String   // 작물 재배 경험
  availableHours String   // 주간 투입 가능 시간
  status         String   @default("applied") // applied → docs → education → matched → operating
  createdAt      DateTime @default(now())
}

// ─── 신원 인증 세션 (OpenDID Verifier 흐름 — 모바일 신분증) ───
model IdentityVerification {
  id        String   @id @default(cuid())
  userId    String?  // 로그인 전 세션도 허용 (익명 → 인증 후 연결)
  user      User?    @relation(fields: [userId], references: [id])
  txId      String   @unique // Verifier 트랜잭션 ID (request-offer-qr)
  status    String   @default("pending") // pending → submitted → verified → failed
  claims    Json?    // confirm-verify로 받은 검증 클레임
  createdAt DateTime @default(now())
}

// ─── 유휴공간 등록 ───
model Space {
  id               String   @id @default(cuid())
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  spaceType        String   // rooftop, vacant_store, indoor
  address          String
  area             String   // ~50평, 50~100평 등 구간 문자열
  electricity      String   // 전기 가능/부분 가능 등
  water            String   // 수도 가능/부분 가능 등
  lighting         String   // 채광 조건: 매우 좋음/좋음/보통/낮음
  preferredMode    String   // 임대형, 수익 공유형, 협의 가능
  photos           String[] // Supabase Storage URL 목록
  suitabilityScore Int?     // 스마트팜 적합도 (%)
  estimatedRent    Int?     // 예상 월 임대 수익 (원)
  status           String   @default("submitted") // submitted, reviewing, approved, rejected
  createdAt        DateTime @default(now())
}

// ─── 지점/사이트 (STO 라운드 단위이자 운영 단위) ───
model Project {
  id            String       @id @default(cuid())
  name          String
  description   String?
  location      String?
  buildingType  String?
  areaSqm       Float?
  // ─── STO 펀딩 (펀딩 전 운영 지점은 null) ───
  tokenSymbol     String?
  tokenPrice      BigInt?         // 원화 단가
  totalTokens     Int?
  soldTokens      Int             @default(0)
  targetAmount    BigInt?
  currentAmount   BigInt          @default(0)
  totalCapex      BigInt          @default(0)
  fundingStart    DateTime?
  fundingEnd      DateTime?
  contractAddress String?
  status        String       @default("operating") // upcoming, funding, funded, operating, paused, rejected, completed, failed
  failedAt      DateTime?    // 마일스톤 기한 초과로 실패 전환된 시각 (status="failed"와 함께 기록)
  imageUrl      String?
  institutionId String?      // 도입 기관 (성과 리포트 집계 단위)
  institution   Institution? @relation(fields: [institutionId], references: [id])
  operatorId    String?      // 이 지점을 운영하는 운영자 (운영자 몫 지급 대상)
  operator      User?        @relation("ProjectOperator", fields: [operatorId], references: [id])
  createdAt     DateTime     @default(now())
  escrow         Escrow?
  milestones     Milestone[]
  transactions   Transaction[]
  tokenHoldings  TokenHolding[]
  dividends      Dividend[]
  partners       ProjectPartner[]
  navSnapshots   NavSnapshot[]
  iotData        IotData[]
  inventories    Inventory[]
  harvestRecords HarvestRecord[]
  salesRecords   SalesRecord[]
  settlementRule SettlementRule?
  payouts        Payout[]
}

// ─── 에스크로 ───
model Escrow {
  id              String  @id @default(cuid())
  projectId       String  @unique
  project         Project @relation(fields: [projectId], references: [id])
  totalLocked     BigInt  @default(0)
  totalReleased   BigInt  @default(0)
  remaining       BigInt  @default(0)
  status          String  @default("active") // active → failed(기한 초과) → refunded(환불 완료)
  contractAddress String?
}

// ─── 마일스톤 ───
model Milestone {
  id                   String         @id @default(cuid())
  projectId            String
  project              Project        @relation(fields: [projectId], references: [id])
  seq                  Int
  name                 String
  description          String?
  releasePct           Int            // 3500 = 35%
  releaseAmount        BigInt         @default(0)
  status               String         @default("pending") // pending, in_progress, verified, completed, failed, manual_review
  conditionText        String?
  requiredSignals      String[]       // ["contract", "receipt", "photo", "iot"]
  iotMinDays           Int            @default(0)
  retryCount           Int            @default(0)
  crossCheck           String?
  assetValue           BigInt         @default(0)
  evidenceUrl          String?
  aiVerificationResult Json?
  completedAt          DateTime?
  // 이 마일스톤의 집행 기한. Escrow.sol의 milestoneDeadline(= 직전 트랜치 집행 +
  // MILESTONE_TIMEOUT 180일)을 DB에 미러링한 값이다. 기한이 지나면 타임아웃 실패
  // 전환(POST /api/milestones/[id]/timeout) 대상이 된다. 아직 시계가 시작되지 않은
  // 단계는 null.
  deadlineAt           DateTime?
  notifications        Notification[]
  appeals              Appeal[]

  @@unique([projectId, seq])
}

// ─── 거래 내역 ───
model Transaction {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  userId      String?  // null = 시스템 거래 (트랜치 해제 등)
  user        User?    @relation(fields: [userId], references: [id])
  type        String   // subscription, tranche_release, dividend, revenue, refund
  amount      BigInt
  tokenAmount Int?
  txHash      String?
  blockNumber Int?
  memo        String?
  createdAt   DateTime @default(now())
}

// ─── 토큰 보유 ───
model TokenHolding {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  amount    Int
  avgPrice  BigInt

  @@unique([userId, projectId])
}

// ─── 배당 ───
model Dividend {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id])
  totalRevenue  BigInt
  totalDividend BigInt
  perToken      BigInt
  period        String
  createdAt     DateTime        @default(now())
  claims        DividendClaim[]
}

// ─── 배당 수령 ───
model DividendClaim {
  id          String   @id @default(cuid())
  dividendId  String
  dividend    Dividend @relation(fields: [dividendId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  tokenAmount Int
  claimAmount BigInt
  claimed     Boolean  @default(false)
  claimedAt   DateTime?
}

// ─── IoT 데이터 ───
model IotData {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  temperature    Float
  humidity       Float
  co2Level       Float
  lightIntensity Float
  phLevel        Float
  growthRate     Float    @default(0)
  anomalyScore   Float    @default(0)
  isAnomaly      Boolean  @default(false)
  recordedAt     DateTime @default(now())

  @@index([projectId, recordedAt])
}

// ─── 알림 (마일스톤 검증 이벤트 + 생육 이상) ───
model Notification {
  id          String     @id @default(cuid())
  projectId   String?    // 생육 이상 발생 지점
  milestoneId String?    // STO 마일스톤 검증 이벤트
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  type        String     // verification_failed, anomaly_detected, manual_review
  message     String
  evidenceUrl String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

// ─── 프로젝트 파트너 ───
model ProjectPartner {
  id                     String  @id @default(cuid())
  projectId              String
  project                Project @relation(fields: [projectId], references: [id])
  role                   String  // landlord, equipment_partner
  name                   String
  totalContribution      BigInt  @default(0)
  recoveredAmount        BigInt  @default(0)
  monthlyRecoveryAmount  BigInt  @default(0)
  recoveryComplete       Boolean @default(false)
}

// ─── NAV 스냅샷 ───
model NavSnapshot {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  nav                Float
  escrowBalance      BigInt
  assetValue         BigInt
  cumulativeCashFlow BigInt
  recordedAt         DateTime @default(now())
}

// ─── AI 검증 결과 캐시 (시연 안정성용) ───
model AiCache {
  id          String   @id @default(cuid())
  milestoneId String
  signalType  String   // contract, receipt, photo
  result      Json?
  createdAt   DateTime @default(now())

  @@unique([milestoneId, signalType])
}

// ─── 데모 캐시 ───
model DemoCache {
  id          String   @id @default(cuid())
  step        Int
  signalType  String?
  txHash      String?
  blockNumber Int?
  result      Json?
  createdAt   DateTime @default(now())
}

// ─── 도입 기관 (공공·대학·ESG 기업) — 성과 리포트 소유자 ───
model Institution {
  id           String    @id @default(cuid())
  name         String
  type         String    // public, university, esg_company
  contactName  String?
  contactEmail String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

// ─── 감사 로그 (청약·검증·집행·정산·권한변경 추적) ───
// 다른 모델과 FK로 묶지 않는다. 감사 기록은 대상 행이 삭제·변경돼도 그 자체로 남아야
// 하므로 actorId·entityId·projectId를 값으로만 들고 있는다.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null = 시스템 이벤트 (스케줄러·자동 집행)
  actorRole  String?  // investor, operator, landlord, admin, system
  action     String   // subscription.created, milestone.verified, payout.processed 등
  entityType String   // project, milestone, dividend, payout, appeal, settlement_rule, user
  entityId   String?
  projectId  String?  // 프로젝트 단위 필터용 (entityType이 project가 아닐 때도 채움)
  summary    String   // 화면에 그대로 뿌리는 한 줄 요약
  detail     Json?    // 변경 전/후 값 등 부가 정보
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

// ─── 정산 규칙 (프로젝트별 — 행이 없으면 lib/waterfall.ts 기본값) ───
// 임대료는 여기 두지 않는다. ProjectPartner(role="landlord").monthlyRecoveryAmount가
// 이미 프로젝트별 월 고정 임대료를 들고 있어 단일 출처로 유지한다.
model SettlementRule {
  id                 String  @id @default(cuid())
  projectId          String  @unique
  project            Project @relation(fields: [projectId], references: [id])
  monthlyPlatformFee BigInt  @default(200000) // 플랫폼 이용료 월 정액
  experienceFeeRate  Float   @default(0.3)    // 체험 중개 수수료율
  b2bFeeRate         Float   @default(0.08)   // B2B 신규계약 성사 수수료율
  // 우선배분/전환 — 흑자 전환 전에는 투자자 배분을 높게 두고(우선배분),
  // 기간 매출이 breakEvenRevenue 이상이면 흑자 구간 비율로 전환한다.
  deficitInvestorShare Float  @default(0.6)
  surplusInvestorShare Float  @default(0.6)
  breakEvenRevenue     BigInt @default(0) // 0 = 전환 없음 (항상 흑자 구간 비율)
  updatedById        String?
  updatedAt          DateTime @updatedAt
}

// ─── 이의제기 (반려·보류 마일스톤에 대한 단계적 재검증) ───
model Appeal {
  id            String    @id @default(cuid())
  milestoneId   String
  milestone     Milestone @relation(fields: [milestoneId], references: [id])
  projectId     String    // 프로젝트 단위 조회용 비정규화 (milestone 조인 회피)
  submittedById String    // 이의제기한 운영자
  reason        String
  // open(접수) → under_review(운영팀 검토) → escalated(외부 전문가) → approved/rejected(최종)
  status        String    @default("open")
  decision      String?   // 최종 판정 사유
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  comments      AppealComment[]

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}

// ─── 이의제기 코멘트 스레드 ───
model AppealComment {
  id            String   @id @default(cuid())
  appealId      String
  appeal        Appeal   @relation(fields: [appealId], references: [id])
  authorId      String
  authorRole    String   // operator, admin (운영팀), auditor (외부 전문가)
  body          String
  attachmentUrl String?  // 보완 자료
  createdAt     DateTime @default(now())

  @@index([appealId, createdAt])
}

// ─── 지급 원장 (배당·임대료·운영자 정산) ───
// MVP 범위: 실제 계좌이체·온체인 전송은 하지 않는다. 지급 예정 건을 등록하고
// 상태(예정/완료/실패)와 증빙만 관리한다 (명세 2.2.1).
model Payout {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  category      String    // dividend, landlord_rent, operator_settlement
  payeeUserId   String?   // 계정이 없는 수취인(건물주 파트너 등)은 null
  payeeName     String
  amount        BigInt
  period        String    // YYYY-MM
  status        String    @default("scheduled") // scheduled → paid / failed
  paidAt        DateTime?
  failureReason String?
  evidenceUrl   String?   // 세금계산서 등 지급 증빙
  memo          String?
  createdAt     DateTime  @default(now())

  // 같은 기간·같은 수취인에게 같은 항목이 두 번 등록되는 것을 막는다.
  @@unique([projectId, period, category, payeeName])
  @@index([payeeUserId, period])
  @@index([status, period])
}

// ─── 품목 마스터 (재배·판매 대상 작물) ───
model Product {
  id        String   @id @default(cuid())
  name      String   // 상추, 루꼴라, 바질
  category  String   // leafy, herb
  unit      String   @default("봉")
  unitPrice Int      // 판매단가 (원)
  growDays  Int      // 파종~수확 재배일수
  createdAt DateTime @default(now())
  inventories    Inventory[]
  harvestRecords HarvestRecord[]
  salesRecords   SalesRecord[]
}

// ─── 재고-생육 (지점×품목 현재 상태) — '오늘 할 일' 집계 원천 ───
model Inventory {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id])
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  inStock           Int       @default(0) // 매장 진열 재고 (봉)
  growing           Int       @default(0) // 재배중 수량 (봉)
  plantedAt         DateTime? // 파종일
  expectedHarvestAt DateTime? // 예상 수확일
  updatedAt         DateTime  @updatedAt

  @@unique([projectId, productId])
}

// ─── 수확 실적 (생산량 집계 — 검증 필드 없음) ───
model HarvestRecord {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      // 수확량 (봉)
  harvestedAt DateTime @default(now())

  @@index([projectId, harvestedAt])
}

// ─── 판매 실적 (운영자 수기입력 — 판매-재배 연동 원천) ───
model SalesRecord {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int      // 판매 수량 (봉)
  amount    Int      // 매출 (원)
  soldAt    DateTime @default(now())

  @@index([projectId, soldAt])
}

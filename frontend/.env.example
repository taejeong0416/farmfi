# frontend 환경변수 샘플 — 실제 값은 .env에 넣으세요 (.env는 gitignore됨)
# 사용법: 이 파일을 복사해 .env로 만들고 각 placeholder를 실제 값으로 교체
#
# 최소 구동에 필요한 것: DATABASE_URL · JWT_SECRET · GEMINI_API_KEY
# 나머지(온체인·신원인증)는 미설정 시 해당 기능이 비활성으로 떨어지고 앱은 정상 동작한다.

# ─── DB (Supabase PostgreSQL) ───
# 마이그레이션(prisma push, DDL)은 세션 pooler 5432, 런타임/시드(DML)는 6543
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:6543/postgres"

# ─── 세션 (이메일+비밀번호 로그인 JWT 서명) ───
# 32바이트 랜덤 hex 권장: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="교체하세요_랜덤32바이트hex"

# ─── AI 검증 (마일스톤 증빙 판독) ───
# 키가 설정된 provider만 Gemini → OpenAI → Anthropic 순서로 시도한다.
# Gemini는 무료 티어로 동작하므로 이것만 넣어도 검증이 돌아간다.
GEMINI_API_KEY="교체하세요"
# OPENAI_API_KEY=""      # 선택 — 채우면 폴백 체인에 자동 합류
# ANTHROPIC_API_KEY=""   # 선택

# ─── 온체인 (마일스톤 검증·트랜치 집행의 온체인 기록) ───
# 주소·키가 없으면 isOnchainEnabled()가 false → 온체인 호출이 null 반환(앱은 정상 동작).
# 체인은 ONCHAIN_* 로 결정하고, 미설정 시 Polygon Amoy(80002)로 폴백한다.
# ESCROW_ADDRESS="0x..."          # Amoy 배포분 (폴백 경로)
# PRIVATE_KEY="0x..."             # 서버 지갑(=배포자=VERIFIER) — 절대 커밋 금지
# ONCHAIN_ESCROW_ADDRESS="0x..."  # 체인 전환 시 우선 적용
# ONCHAIN_PRIVATE_KEY="0x..."
# ONCHAIN_RPC_URL=""              # 서버 전용 (NEXT_PUBLIC_ 접두사 금지 — RPC 토큰 노출 방지)
# ONCHAIN_CHAIN_ID="80002"
# ONCHAIN_NAME="Polygon Amoy"
# ONCHAIN_GAS_ZERO="false"        # gas 0 체인(OmniOne Chain 등)이면 true
# NEXT_PUBLIC_ONCHAIN_CHAIN_ID="80002"  # 탐색기 링크용 (체인 변경 시 함께 수정)

# ─── 신원인증 KYC (OpenDID Verifier — 오라클 자체호스팅). 로그인과 별개(실명·성인 확인) ───
# 미설정(=stub)이면 3초 자동인증 목업 → 데모 항상 됨. 자세한 건 docs/opendid-verifier-연동.md
IDENTITY_PROVIDER="stub"                             # stub | opendid
IDENTITY_VERIFIER_URL="http://168.138.36.235:8092"   # 오라클 Verifier (ephemeral IP — 재생성 시 변경)
IDENTITY_VERIFIER_POLICY_ID="9c4a780e-af30-4f85-a49b-b188e8e10456"  # 등록된 VP 정책

# ─── 투자금 납입 (가상계좌) ───
# 제공사 계약 전까지는 Mock 어댑터가 은행 역할을 한다 (src/lib/payment.ts)
# BANK_WEBHOOK_SECRET=""              # 입금 웹훅 서명 검증 키. 미설정이면 검증을 건너뜀
# DEPOSIT_DEADLINE_HOURS="24"         # 입금기한
# MOCK_BANK_SCENARIO="normal"         # normal | issue_failed | mismatch | delayed (I-03E 분기)
# MOCK_BANK_DEPOSIT_DELAY_SEC="0"     # Mock 은행이 입금하기까지 걸리는 시간

# ─── 데모 ───
# live = 실 Gemini·온체인 호출 / cached = 저장된 성공 결과 재생 (발표 시연 권장)
DEMO_MODE="live"

# ─── 수탁 지갑 (v2.1) ───
# 투자자 수탁 지갑 개인키를 AES-256-GCM으로 감싸는 마스터 키 (32바이트 hex).
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 로 만든다.
# 없으면 지갑을 만들지 않는다 — 평문 저장으로 물러서지 않는다. 운영은 KMS/HSM.
CUSTODY_MASTER_KEY=
# 보유 구좌를 발행할 토큰 컨트랙트. 미설정이면 FARM_TOKEN_ADDRESS로 폴백한다.
ONCHAIN_FARM_TOKEN_ADDRESS=

# 대사 크론(/api/cron/reconcile) 보호용. 없으면 엔드포인트가 503으로 닫힌다.
# Vercel Cron이 Authorization: Bearer <값>으로 부른다.
CRON_SECRET=
